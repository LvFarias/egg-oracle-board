{
  "manifest_version": 3,
  "name": "Oracle Board Calculator",
  "version": "1.3",
  "description": "Calculates the contract prediction leaderboard on Discord.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.discord.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}